#!/usr/bin/env bash
# bench-lock: one bench at a time per machine.
#
#   bench-lock run -- <command...>   wait for the lock, then become the command
#   bench-lock status                who holds the lock, who is waiting
#   bench-lock reading               the calm verdict, now, on stdout
#   bench-lock settle                wait for a noisy machine, then the verdict
#
# Two benches sharing a machine measure each other, and the wrong number they
# produce is perfectly plausible. `run` waits its turn in arrival order, takes
# the machine's single bench lock, then replaces itself with the command
# (`exec`): same pid, same terminal, stdin and environment, and the signals
# and the exit code are the command's own. The wait has no time limit.
#
# Nobody gives the lock back. The lock records its holder's pid and the time
# that process started, and it is free as soon as that process is gone, or as
# soon as that pid belongs to a process that started at another time (the pid
# was reused). The next in line judges this and takes the lock over, so a
# holder killed with -9 is just one more way for a bench to end. The same
# judgement skips a waiter that died without leaving the queue.
#
# The command sees BENCH_LOCK_HELD. A `run` that sees it is already under the
# lock and runs its command directly.
#
# Just before the command starts, one stderr line names the machine and says
# whether its CPU was calm or noisy (see "The calm verdict" below). A noisy
# machine is first waited on, under the lock, for a capped time (see "The
# settle wait" below). Once the command is over, one more stderr line gives the
# reading over the whole run (see "The end-of-run verdict" below). A noisy
# verdict is followed by the busiest processes besides the bench (see "The
# culprits" below). None of them ever changes the exit code.
#
# BENCH_LOCK_OWN_PIDS, set for the command, names a file, created empty, where
# it lists processes of its own outside its tree, one pid per line, any time
# during the run (see "The end-of-run verdict" below).
#
# BENCH_LOCK_END_MARKER, read by `run`, names a file created once the
# end-of-run line is out: bench-remote waits on it, since its stderr is a log
# file, not a pipe that closes when the line is written.
#
# `settle` does the same wait on its own, lock or no lock: for a caller that
# holds the lock already and has loaded the machine since (bench-remote, after
# its install). Called by the holder itself, it also starts the end-of-run
# reading over from there.
#
# Bash and standard POSIX utilities only, and nothing here knows where this
# file lives: it must run on a machine that has neither Node nor the harness.
# Bash 3.2 included, which is what macOS ships as /bin/bash.
set -u

# Any failure of the tool itself exits 125, as `env` and `timeout` do: 1 and 2
# belong to the wrapped command, and a bench verdict must never be mistaken for
# a typo or a broken state directory.
die() {
  echo "bench-lock: $1" >&2
  exit 125
}

usage() {
  {
    echo "Usage: bench-lock run -- <command...>"
    echo "       bench-lock status"
    echo "       bench-lock reading"
    echo "       bench-lock settle"
  } >&2
  exit 125
}

is_number() {
  case "$1" in "" | *[!0-9]*) return 1 ;; esac
}

# ── Where the state lives ────────────────────────────────────────────────────
# A neutral per-user path, the same on a machine with or without the harness.
# A relative XDG_STATE_HOME is ignored, as the XDG specification asks: it would
# make the lock depend on the caller's working directory, and a second lock
# path is a second bench running.
resolve_state() {
  case "${XDG_STATE_HOME:-}" in
    /*) state="$XDG_STATE_HOME/bench-lock" ;;
    *)
      [ -n "${HOME:-}" ] || die "neither XDG_STATE_HOME nor HOME says where the state directory is"
      state="$HOME/.local/state/bench-lock"
      ;;
  esac
  # `mkdir` succeeds for exactly one caller on every POSIX filesystem: the lock
  # is a directory, and so is each ticket of the queue in front of it.
  lock="$state/lock"
  tickets="$state/tickets"
}

# ── Is a process still the one that was recorded? ────────────────────────────
# A process is named by its pid and the time it started, as `ps` prints it: a
# pid alone can be handed to an unrelated process once its owner is gone. `ps`,
# not `kill -0`: a process of another user answers EPERM, which is "alive"
# spelled like "dead". A zombie has ended; only its parent has not looked yet.
# `ps` prints the start time in the reader's language and time zone, so both
# are pinned: a holder and a waiter must spell the same time the same way.
process_started=""
look_up() { # $1 = pid; 0 = running, 1 = gone, 2 = cannot tell
  local found
  process_started=""
  found="$(LC_ALL=C TZ=UTC0 ps -o stat= -o lstart= -p "$1" 2>/dev/null)"
  case "$?" in
    0) ;;
    1) return 1 ;;
    *) return 2 ;;
  esac
  found="${found#"${found%%[! ]*}"}"
  case "$found" in "" | Z*) return 1 ;; esac
  found="${found#* }"
  found="${found#"${found%%[! ]*}"}"
  process_started="${found%"${found##*[! ]}"}"
}

# Dead when its process is gone or started at another time. A record that
# cannot be judged (`ps` could not be asked, a start time that was never
# recorded) belongs to a live process: a mistaken "dead" costs two benches
# measuring each other, a mistaken "alive" only a wait.
is_dead() { # $1 = pid, $2 = the start time recorded for it
  is_number "$1" || return 1
  look_up "$1"
  case "$?" in
    1) return 0 ;;
    2) return 1 ;;
  esac
  [ -n "$2" ] && [ "$process_started" != "$2" ]
}

# ── Who is who ───────────────────────────────────────────────────────────────
# The lock and every ticket carry one record: pid, that process's start time,
# since when (seconds since the epoch), working directory and command, one per
# line. It is written whole by a single builtin, right after the `mkdir` that
# creates the directory.
command_line="" own_started=""
write_record() { # $1 = directory, $2 = since when
  printf '%s\n%s\n%s\n%s\n%s\n' "$$" "$own_started" "$2" "${PWD//$'\n'/ }" "${command_line//$'\n'/ }" >"$1/owner"
}

record_pid="" record_started="" record_since="" record_cwd="" record_command=""
read_record() { # $1 = directory
  record_pid="" record_started="" record_since="" record_cwd="" record_command=""
  [ -f "$1/owner" ] || return 1
  {
    IFS= read -r record_pid &&
      IFS= read -r record_started &&
      IFS= read -r record_since &&
      IFS= read -r record_cwd &&
      IFS= read -r record_command
  } 2>/dev/null <"$1/owner"
}

# Renamed, then removed: the rename is atomic, so the directory is gone in one
# step, and of two callers removing the same one, exactly one does it.
remove() { # $1 = directory
  if mv "$1" "$state/removed.$$" 2>/dev/null; then rm -rf "$state/removed.$$"; fi
}

# 42s, 3m12s, 2h05m: an age a person reads at a glance.
age=""
set_age() { # $1 = since when, $2 = now
  local seconds
  if ! is_number "$1"; then
    age="an unknown time"
    return
  fi
  seconds=$(($2 - $1))
  [ "$seconds" -ge 0 ] || seconds=0
  if [ "$seconds" -lt 60 ]; then
    age="${seconds}s"
  elif [ "$seconds" -lt 3600 ]; then
    age="$((seconds / 60))m$(printf '%02d' $((seconds % 60)))s"
  else
    age="$((seconds / 3600))h$(printf '%02d' $((seconds % 3600 / 60)))m"
  fi
}

# ── The queue ────────────────────────────────────────────────────────────────
# A ticket is a directory named by a number, and the lowest number is served
# first. A new ticket is one past the highest, so a number is never handed out
# again while a higher ticket exists.
queue_lowest="" queue_highest=0 queue_ahead=0
scan_queue() { # $1 = this caller's ticket number, when it has one
  local entry number
  queue_lowest="" queue_highest=0 queue_ahead=0
  for entry in "$tickets"/*; do
    number="${entry##*/}"
    is_number "$number" || continue
    if [ -z "$queue_lowest" ] || [ "$number" -lt "$queue_lowest" ]; then
      queue_lowest="$number"
    fi
    if [ "$number" -gt "$queue_highest" ]; then
      queue_highest="$number"
    fi
    if [ -n "${1:-}" ] && [ "$number" -lt "$1" ]; then
      queue_ahead=$((queue_ahead + 1))
    fi
  done
}

# Two callers that pick the same number are told apart by `mkdir`: one of them
# gets it, the other looks again.
ticket="" ticket_number=""
take_ticket() {
  local now number attempts=0
  now="$(date +%s)"
  while :; do
    scan_queue
    number=$((queue_highest + 1))
    if mkdir "$tickets/$number" 2>/dev/null; then
      ticket="$tickets/$number"
      ticket_number="$number"
      write_record "$ticket" "$now"
      return
    fi
    # Losing a number to another caller is settled on the next pass. A hundred
    # passes is not contention: the directory cannot be written.
    attempts=$((attempts + 1))
    [ "$attempts" -lt 100 ] || die "cannot take a ticket in $tickets"
    [ -d "$tickets" ] || mkdir -p "$tickets" || die "cannot create the state directory $tickets"
  done
}

# First in line once every ticket below this caller's is gone. The lowest one
# is judged, and removed when its waiter died; one look per poll is enough,
# the next poll judges the next. Only tickets below this caller's own are ever
# removed: such a number cannot be handed out again while this caller's ticket
# exists, so what is removed is the dead waiter's, never a newcomer's.
#
# A ticket without a record is a waiter between its `mkdir` and its record, a
# matter of microseconds. One still without a record three polls later belongs
# to a waiter that died right there, and is removed like any dead waiter's.
recordless="" recordless_polls=0
is_first_in_line() {
  scan_queue "$ticket_number"
  [ "$queue_lowest" = "$ticket_number" ] && return 0
  if read_record "$tickets/$queue_lowest"; then
    is_dead "$record_pid" "$record_started" || return 1
  else
    if [ "$recordless" = "$queue_lowest" ]; then
      recordless_polls=$((recordless_polls + 1))
    else
      recordless="$queue_lowest" recordless_polls=1
    fi
    [ "$recordless_polls" -ge 3 ] || return 1
  fi
  remove "$tickets/$queue_lowest"
  scan_queue "$ticket_number"
  [ "$queue_lowest" = "$ticket_number" ]
}

# Only the first in line calls this, so nobody else takes the lock meanwhile:
# a lock judged dead here is still the dead holder's when it is removed.
take_lock() { # $1 = now
  if ! mkdir "$lock" 2>/dev/null; then
    if read_record "$lock"; then
      is_dead "$record_pid" "$record_started" || return 1
    fi
    # A lock without a record was being taken by the waiter that was first in
    # line before this one. That waiter is dead, or its ticket would still be
    # ahead of this caller's.
    remove "$lock"
    mkdir "$lock" 2>/dev/null || return 1
  fi
  write_record "$lock" "$1"
}

# ── status ───────────────────────────────────────────────────────────────────
status() {
  local now number position=0
  resolve_state
  now="$(date +%s)"
  if read_record "$lock"; then
    if is_dead "$record_pid" "$record_started"; then
      echo "free: no bench holds the lock"
    else
      set_age "$record_since" "$now"
      echo "holder: pid $record_pid, held for $age, in $record_cwd: $record_command"
    fi
  elif [ -d "$lock" ]; then
    # Between the `mkdir` and the record: a holder, a few microseconds old.
    echo "holder: taking the lock right now"
  else
    echo "free: no bench holds the lock"
  fi
  # Ticket names are numbers and nothing else, so this listing splits safely.
  for number in $(ls "$tickets" 2>/dev/null | sort -n); do
    is_number "$number" || continue
    if read_record "$tickets/$number"; then
      is_dead "$record_pid" "$record_started" && continue
      position=$((position + 1))
      set_age "$record_since" "$now"
      echo "waiter $position: pid $record_pid, waiting for $age, in $record_cwd: $record_command"
    elif [ -d "$tickets/$number" ]; then
      position=$((position + 1))
      echo "waiter $position: joining the queue right now"
    fi
  done
}

# ── The calm verdict ─────────────────────────────────────────────────────────
# A bench that comes back red is only worth believing if the machine was calm
# when it was measured. Just before the command starts, one stderr line names
# the machine and says whether it was: how busy the CPU is right now, sampled
# over about a second and given per core (0 idle, 1 every core busy), against
# a threshold. Read before the run only, since the bench itself loads the
# machine afterwards. Whatever the verdict says, and whether or not the
# machine can be read, the command starts once it is said and its exit code is
# its own.
#
# When the CPU cannot be sampled, the one-minute load average divided by the
# number of cores stands in: it lags, a spike of the last minute hides or fakes
# noise, but it is a verdict. The line names which reading it used, `cpu` or
# `load`, and says `load unknown: no verdict` when neither could be read.
#
# The default threshold sits between a quiet machine at rest (well under 0.10
# CPU busy per core) and a laptop busy with builds and browsers. Half the cores
# already busy is enough to skew a measurement. BENCH_LOCK_NOISY_ABOVE moves
# it, per machine.
default_noisy_above=0.50

# The utilities that live outside /usr/bin and /bin are called by absolute
# path below: a bench started from a git hook or over a bare ssh has a
# stripped PATH.

# The machine's short name: macOS's LocalHostName, else the host name without
# its local-network suffix. On a Mac the host name says MacBookPro.lan where
# people say laptop, and two spellings of one machine would read as two machines.
machine_name() {
  local name=""
  if [ -x /usr/sbin/scutil ]; then
    name="$(/usr/sbin/scutil --get LocalHostName 2>/dev/null)"
  fi
  if [ -z "$name" ]; then
    name="$(uname -n 2>/dev/null)"
    name="${name%.local}"
    name="${name%.lan}"
  fi
  printf '%s' "${name:-an unnamed machine}"
}

is_decimal() {
  case "$1" in "" | . | *[!0-9.]* | *.*.*) return 1 ;; esac
}

# The CPU time counters of Linux's /proc/stat, all cores summed: "busy total",
# where idle and iowait are the only time not busy. Guest time is already
# counted in user time, so only the first eight counters add up to the total.
proc_stat_counters() {
  local label user nice system idle iowait irq softirq steal
  # The redirection fails before a 2>/dev/null of its own applies: the group
  # silences it.
  { read -r label user nice system idle iowait irq softirq steal _ </proc/stat; } 2>/dev/null || return 1
  [ "$label" = cpu ] || return 1
  awk -v u="$user" -v n="$nice" -v s="$system" -v i="$idle" -v w="${iowait:-0}" \
    -v q="${irq:-0}" -v sq="${softirq:-0}" -v st="${steal:-0}" 'BEGIN {
      total = u + n + s + i + w + q + sq + st
      printf "%.0f %.0f", total - i - w, total
    }'
}

# CPU busy per core over about a second, or nothing when it cannot be sampled:
# two /proc/stat readings a second apart on Linux; on macOS, iostat's second
# line, whose idle share covers the second since its first. Both are shares of
# all the cores together, so they are already per core. Not top: it costs a
# second and a half of CPU per reading, and the sampler below reads every two
# seconds while the bench runs.
# BENCH_LOCK_CPU_PER_CORE imposes the reading, for this tool's own tests; a
# value that is not a number stands for a sampling that failed. An absolute
# path names a file whose first line is the reading, read anew each time: the
# environment is read once per run, and a test of the settle wait needs a
# reading that turns calm while the run waits.
cpu_per_core() {
  local before after idle imposed
  if [ -n "${BENCH_LOCK_CPU_PER_CORE:-}" ]; then
    imposed="$BENCH_LOCK_CPU_PER_CORE"
    case "$imposed" in
      /*) imposed="" && { read -r imposed <"$BENCH_LOCK_CPU_PER_CORE"; } 2>/dev/null ;;
    esac
    is_decimal "$imposed" && printf '%s' "$imposed"
    return 0
  fi
  if [ -r /proc/stat ]; then
    before="$(proc_stat_counters)" || return 0
    sleep 1
    after="$(proc_stat_counters)" || return 0
    awk -v before="$before" -v after="$after" 'BEGIN {
      split(before, b, " "); split(after, a, " ")
      if (a[2] - b[2] > 0) printf "%.4f", (a[1] - b[1]) / (a[2] - b[2])
    }'
  elif [ -x /usr/sbin/iostat ] && [ "$(uname -s 2>/dev/null)" = Darwin ]; then
    # A header naming the columns ("us sy id 1m 5m 15m"), then one line since
    # boot, then one over the second that followed.
    idle="$(LC_ALL=C /usr/sbin/iostat -n 0 -w 1 -c 2 2>/dev/null | awk '
      NR == 2 { for (i = 1; i <= NF; i++) if ($i == "id") column = i }
      NR > 2 && column { idle = $column }
      END { print idle }')"
    is_decimal "$idle" || return 0
    awk -v idle="$idle" 'BEGIN { printf "%.4f", (100 - idle) / 100 }'
  fi
}

# The one-minute load average: Linux's /proc, else the BSD sysctl.
load_average() {
  local reading=""
  if [ -r /proc/loadavg ]; then
    read -r reading _ </proc/loadavg
  elif [ -x /usr/sbin/sysctl ]; then
    # "{ 1.23 1.45 1.50 }"
    reading="$(/usr/sbin/sysctl -n vm.loadavg 2>/dev/null)"
    reading="${reading#\{ }"
    reading="${reading%% *}"
  fi
  printf '%s' "$reading"
}

# The load per core, or nothing when it cannot be read. BENCH_LOCK_LOAD_PER_CORE
# imposes the reading, for this tool's own tests.
load_per_core() {
  local load cores
  if [ -n "${BENCH_LOCK_LOAD_PER_CORE:-}" ]; then
    printf '%s' "$BENCH_LOCK_LOAD_PER_CORE"
    return
  fi
  load="$(load_average)"
  cores="$(getconf _NPROCESSORS_ONLN 2>/dev/null)"
  is_decimal "$load" && is_number "$cores" && [ "$cores" -gt 0 ] || return 0
  awk -v load="$load" -v cores="$cores" 'BEGIN { printf "%.4f", load / cores }'
}

noisy_above() {
  if is_decimal "${BENCH_LOCK_NOISY_ABOVE:-}"; then
    printf '%s' "$BENCH_LOCK_NOISY_ABOVE"
  else
    printf '%s' "$default_noisy_above"
  fi
}

# The machine's reading right now, as "<source> <value>": the CPU, else the
# load average, or nothing when neither can be read.
reading_now() {
  local value
  value="$(cpu_per_core)"
  if is_decimal "$value"; then
    printf 'cpu %s' "$value"
    return
  fi
  value="$(load_per_core)"
  is_decimal "$value" && printf 'load %s' "$value"
}

# One reading of the machine, kept for the settle wait and the verdict: the
# reading itself ("cpu 0.42 per core", "load unknown"), and whether it is
# noisy. A machine that cannot be read is not noisy: nothing says it is.
# `bench-lock reading` prints one such reading alone, for a tool that tags
# each of its own runs with it, under the lock or not.
reading=""
read_machine() {
  local value source noisy_above
  noisy_above="$(noisy_above)"
  value="$(reading_now)"
  source="${value%% *}"
  value="${value#* }"
  if is_decimal "$value"; then
    reading="$(awk -v source="$source" -v value="$value" -v above="$noisy_above" 'BEGIN {
      printf "%s %.2f per core: %s (noisy above %.2f)", source, value, (value + 0 > above + 0 ? "noisy" : "calm"), above
    }')"
  else
    reading="load unknown: no verdict"
  fi
}

reading_is_noisy() {
  case "$reading" in *": noisy ("*) ;; *) return 1 ;; esac
}

say_verdict() { # $1 = what the settle wait adds, if anything
  echo "bench-lock: on $(machine_name), $reading${1:-}" >&2
  ! reading_is_noisy || say_culprits "$(busiest "$$")"
}

# ── The culprits ─────────────────────────────────────────────────────────────
# A noisy verdict says to rerun, not what to close first. So every noisy
# verdict, at the start or at the end of the run, is followed by one more
# stderr line naming the busiest processes by CPU, the bench and its
# descendants left out; a calm verdict is not.
#
#   bench-lock: busiest besides the bench: node (pid 4242, 85% cpu), yes (pid 77, 40% cpu), mds (pid 12, 12% cpu)
#
# CPU percent as `ps` gives it, of one core, so above 100 for a process busy on
# several: a decaying average on macOS, the average over the process's whole
# life on Linux. `none` means every busy process belonged to the bench. At the
# start no bench runs yet: bench-lock itself is left out, the process about to
# become the bench. During the run the processes are read at each reading,
# since by the end they may be gone, and those of the noisy readings are
# named, their CPU percent averaged over them.
culprit_count=3

# pid, parent pid, CPU percent, CPU time and command of every process, one
# per line. The CPU time is cumulative, as `ps` prints it: [[dd-]hh:]mm:ss
# with hundredths on macOS, [dd-]hh:mm:ss in whole seconds on Linux.
# BENCH_LOCK_PROCESSES names a file that stands in for it, for this tool's own
# tests, read anew each time: a case writes the bench's pid in it once the
# bench has one.
process_table() {
  if [ -n "${BENCH_LOCK_PROCESSES:-}" ]; then
    cat "$BENCH_LOCK_PROCESSES" 2>/dev/null
    return 0
  fi
  LC_ALL=C ps -A -o pid= -o ppid= -o pcpu= -o time= -o comm= 2>/dev/null
}

# Names a process by the command that ends its line in the process table: a
# path by its last component, since macOS gives the path, with spaces in it,
# where Linux gives a short name. Shared by the awk programs below.
command_of_awk='
  function command_of(line,   name) {
    name = line
    sub(/^[ \t]*[^ \t]+[ \t]+[^ \t]+[ \t]+[^ \t]+[ \t]+[^ \t]+[ \t]+/, "", name)
    if (name ~ /^\//) sub(/.*\//, "", name)
    return name
  }
'

# Reads the process table into pid[], parent[], cpu[] and command[], and
# marks in out[] the pids in `roots` and their descendants: the head of the
# awk program below, which adds its own END.
process_tree_awk="$command_of_awk"'
  { pid[NR] = $1; parent[NR] = $2; cpu[NR] = $3; command[NR] = command_of($0) }
  function leave_out(   n, i, grown) {
    n = split(roots, root, " ")
    for (i = 1; i <= n; i++) out[root[i]] = 1
    do {
      grown = 0
      for (i = 1; i <= NR; i++) if (!(pid[i] in out) && (parent[i] in out)) { out[pid[i]] = 1; grown = 1 }
    } while (grown)
  }
'

# The busiest processes but the given pids and their descendants, as the
# culprit line lists them, `none` when there is none, or a failure when the
# process table cannot be read.
busiest() { # $@ = the pids left out, with their descendants
  process_table | awk -v roots="$*" -v count="$culprit_count" "$process_tree_awk"'
    END {
      if (NR == 0) exit 1
      leave_out()
      for (k = 1; k <= count; k++) {
        best = 0
        for (i = 1; i <= NR; i++)
          if (!(pid[i] in out) && !(i in named) && cpu[i] + 0 > 0 && (!best || cpu[i] + 0 > cpu[best] + 0)) best = i
        if (!best) break
        named[best] = 1
        printf "%s%s (pid %s, %.0f%% cpu)", (k > 1 ? ", " : ""), command[best], pid[best], cpu[best]
      }
      if (k == 1) printf "none"
    }'
}

# Now in seconds since the epoch, to the nanosecond where `date` can, else to
# the second.
wall_now() {
  local now
  now="$(date +%s.%N 2>/dev/null)"
  is_decimal "$now" || now="$(date +%s)"
  printf '%s' "$now"
}

say_culprits() { # $1 = what busiest gave; nothing when it could not tell
  [ -z "$1" ] || echo "bench-lock: busiest besides the bench: $1" >&2
}

# ── The settle wait ──────────────────────────────────────────────────────────
# A bench started on a busy machine measures the machine, not the code. So
# under the lock, before the verdict, a noisy machine is read again every poll
# until it reads calm, with a line on stderr at once and then every notice
# period, as a waiter in the queue prints. Capped, since a machine that stays
# busy for good must not hold every bench back: once the cap runs out the
# command starts anyway, and the verdict says the wait ran out. The cap is
# BENCH_LOCK_SETTLE seconds, 120 by default; 0 turns the wait off. A machine
# that cannot be read is not waited on.
default_settle=120
settle() {
  local cap="$default_settle" started="$SECONDS" next=0
  if is_number "${BENCH_LOCK_SETTLE:-}"; then cap="$BENCH_LOCK_SETTLE"; fi
  read_machine
  while reading_is_noisy && [ "$cap" -gt 0 ]; do
    if [ $((SECONDS - started)) -ge "$cap" ]; then
      say_verdict "; the settle wait ran out after ${cap}s"
      return
    fi
    if [ "$SECONDS" -ge "$next" ]; then
      next=$((SECONDS + notice_every))
      echo "bench-lock: waiting for the machine to settle, ${reading/: noisy/}, $((SECONDS - started))s waited of ${cap}s at most" >&2
    fi
    sleep "$poll_every"
    leave_if_asked
    read_machine
  done
  say_verdict
}

# ── The end-of-run verdict ───────────────────────────────────────────────────
# Load that arrives mid-measurement skews it as much as load at the start. Just
# before `exec`, a sampler is forked that watches the bench's pid, takes the
# reading every $sample_every seconds while it runs, and once it is gone says
# one more stderr line: the 90th percentile of the run's readings, per core,
# noisy when it is above the threshold, then the busiest reading and the mean,
# for information.
#
#   bench-lock: on laptop, during the run, cpu besides the bench p90 0.55, max 0.62, mean 0.31 per core: noisy (noisy above 0.50)
#
# The percentile, not the busiest reading: each reading covers about one
# second, and on a quiet machine a single second of a background daemon would
# otherwise decide the whole run. One noisy second in ten is forgiven; load
# that lasts is not. It is the nearest rank: the reading at rank ceil(0.9 n)
# once sorted, so a run of fewer than ten readings is judged on its busiest.
#
# What it judges is the load besides the bench, since a bench that keeps every
# core busy would otherwise read noisy by its own doing: each reading of the
# machine, less what the bench and its descendants used over that very
# reading: the CPU time they consumed, read from the culprits' process table
# (`ps -o time`) just before and just after it, over the wall time between
# the two and the core count. A process that appeared in between counts from
# zero, one that vanished counts for nothing, its last moments unknown. A
# reading for which that CPU time cannot be read is kept whole.
#
# The bench's tree is its descendants by parent pid, and one more root for
# every pid listed in the BENCH_LOCK_OWN_PIDS file at any time during the run:
# a browser started through `open` belongs to launchd, not to the bench. A
# line that is not a pid, or a file that cannot be read, adds nothing.
#
# The tree is judged once the run is over, not reading by reading: a browser
# is at its busiest while it starts, before the bench can know its pid, and a
# reading judged there and then would count that startup as load besides the
# bench and name the browser a culprit. So each reading keeps, in a
# temporary file, the CPU time every busy process consumed over it, with its
# parent pid, CPU percent and command, and the ancestors that link it to its
# root. Once the bench is gone every reading is judged against the tree as
# the run declared it in the end.
#
# What the bench makes a system process do is load besides it all the same.
# On macOS, WindowServer composites every window a headed browser draws: a
# quarter of one core for one app's Chrome on an M2 mini, 0.03 per core of
# its eight. It cannot be declared, by pid or by name: it composites for
# every app on the display, and declaring it would hide the load any other
# app puts on it too. A bench whose share there matters runs headless.
#
# The sampler is no child of the bench: it is forked from a subshell that
# exits at once, so the bench's `wait` and `pgrep -P` never see it. It ignores
# the signals a terminal or a `kill` of the process group sends, since they
# are the bench's to decide on: it ends when the bench does, and only then,
# with nothing but stderr open. A caller that reads stderr through a pipe
# therefore sees the line before the pipe closes; one that only waits for the
# pid may return a moment before the line lands, and waits for the marker file
# below instead.
#
# The watch is bash 3.2 and POSIX only: `kill -0` every $poll_every seconds,
# a builtin that costs the bench nothing, and at every reading the pid and
# start time through `ps`, which also tells a zombie or a reused pid from the
# bench. BENCH_LOCK_SAMPLE_SECONDS sets the period, whole seconds and not
# zero, for this tool's own tests: a case that needs ten readings.
sample_every=2

# On macOS the run is also read for what slows a CPU down without loading it,
# at every sample, the worst of the run kept:
#
# - the CPU speed limit the system imposes when hot, `CPU_Speed_Limit` in
#   `pmset -g therm`, 100 when "No CPU power status has been recorded". Only
#   Intel Macs report it; Apple Silicon prints that note and nothing else.
# - the thermal pressure level, `notifyutil -g
#   com.apple.system.thermalpressurelevel`, what an app reads as its thermal
#   state: 0 nominal, 1 moderate, 2 heavy, 3 trapping, 4 sleeping
#   (OSThermalNotification.h). The one reading Apple Silicon gives at all.
# - the power source, `pmset -g batt`.
#
# Seen on real hardware, an M1 Max laptop on macOS 27 and an M2 mini on macOS
# 26: `pmset -g therm` prints only the three "No ... has been recorded" notes,
# at rest and, on the laptop, under a load average of 15 too; the thermal
# pressure level reads 0 at rest and 1 (moderate) on the laptop under that
# load. Not seen, taken from pmset's own format strings and the header named
# above: pressure levels above 1, and the Intel speed limit.
#
# A limit below 100 or a thermal pressure above normal at any
# reading, or a reading on battery, makes the run noisy whatever the CPU reads,
# and the line says which:
#
#   ... per core: calm (noisy above 0.50); thermal pressure heavy: noisy; on battery power: noisy
#
# A value that cannot be read reads "unknown", flagged neither way. Other
# systems are not read and the line says nothing of them. BENCH_LOCK_PMSET and
# BENCH_LOCK_NOTIFYUTIL name the programs to run as pmset and notifyutil, for
# this tool's own tests, on any system.
macos_program() { # $1 = the override's value, $2 = the program's path on macOS
  if [ -n "$1" ]; then
    printf '%s' "$1"
  elif [ -x "$2" ] && [ "$(uname -s 2>/dev/null)" = Darwin ]; then
    printf '%s' "$2"
  fi
}

# The CPU speed limit, a number, or "unknown".
speed_limit() { # $1 = the pmset program
  LC_ALL=C "$1" -g therm 2>/dev/null | awk '
    $1 == "CPU_Speed_Limit" { limit = $NF }
    /No CPU power status has been recorded/ { no_limit = 1 }
    END { print (limit != "" ? limit : no_limit ? 100 : "unknown") }'
}

# The thermal pressure level, a number, or "unknown".
thermal_pressure() { # $1 = the notifyutil program
  local level
  level="$(LC_ALL=C "$1" -g com.apple.system.thermalpressurelevel 2>/dev/null | awk '{ level = $NF } END { print level }')"
  if is_number "$level"; then printf '%s' "$level"; else printf unknown; fi
}

# "battery" when the machine draws from its battery, "mains" from anything
# else pmset names (AC, a UPS), or "unknown".
power_source() { # $1 = the pmset program
  case "$(LC_ALL=C "$1" -g batt 2>/dev/null)" in
    *"drawing from 'Battery Power'"*) printf battery ;;
    *"drawing from '"*) printf mains ;;
    *) printf unknown ;;
  esac
}

# A new reading (thermal, power, CPU) is taken in sample_once and judged in
# say_run_verdict, nowhere else. reset_run_readings forgets what the run kept:
# at the start, and when the window starts over. What the bench declared is
# kept across a new window: its processes are still its own.
run_pmset="" run_notifyutil="" run_dir="" run_count=0
reset_run_readings() {
  run_source="" run_count=0
  run_speed_limit="" run_pressure="" run_power=""
  if [ -n "$run_dir" ]; then { : >"$run_dir/samples"; } 2>/dev/null; fi
}
reset_run_readings

# Adds the pids listed in the BENCH_LOCK_OWN_PIDS file to run_declared,
# space-separated, each once. Read at every reading and once more at the end:
# the file lives in the lock directory, which the next bench may already have
# taken over by then.
run_bench="" run_left_out="" run_own_pids="" run_declared=""
note_declared() {
  local line
  [ -n "$run_own_pids" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    is_number "$line" || continue
    case "$run_declared " in *" $line "*) ;; *) run_declared="$run_declared $line" ;; esac
  done <"$run_own_pids" 2>/dev/null
}

# Appends one reading to the samples file, from the process table read just
# before it (the first file) and just after it (the second):
#
#   S <reading> <wall seconds between the two tables> <1 when the table was read, else 0>
#   P <pid> <parent pid> <CPU seconds used over the reading, or ?> <CPU percent> <command>
#
# A P line for every process that used CPU over the reading or shows a CPU
# percent, and for each of its ancestors, idle ones included: the end of the
# run needs them to tell whose tree it belongs to. A process absent from the
# first table counts from zero; one whose CPU time cannot be read, or a first
# table that could not be read at all, gives ?.
record_sample_awk="$command_of_awk"'
  function seconds(t,   days, n, part, total, i) {
    if (t !~ /^([0-9]+-)?([0-9]+:)*[0-9]+(\.[0-9]+)?$/) return -1
    days = 0
    if (index(t, "-")) { days = substr(t, 1, index(t, "-") - 1); t = substr(t, index(t, "-") + 1) }
    n = split(t, part, ":")
    total = 0
    for (i = 1; i <= n; i++) total = total * 60 + part[i]
    return days * 86400 + total
  }
  FILENAME == ARGV[1] { before[$1] = seconds($4); known++; next }
  {
    n++
    pid[n] = $1; parent[n] = $2; cpu[n] = $3; command[n] = command_of($0); row[$1] = n
    time = seconds($4)
    if (!known || time < 0 || ($1 in before && before[$1] < 0)) used[n] = "?"
    else if (($1 in before) && time >= before[$1]) used[n] = time - before[$1]
    else used[n] = time
  }
  END {
    printf "S %s %.4f %d\n", value, ended - started, (n > 0)
    for (i = 1; i <= n; i++) {
      if (used[i] == 0 && cpu[i] + 0 <= 0) continue
      # The process and its ancestors, each once.
      for (j = i; j && !(j in kept); j = row[parent[j]]) kept[j] = 1
    }
    for (i = 1; i <= n; i++)
      if (i in kept) printf "P %s %s %s %s %s\n", pid[i], parent[i], (used[i] == "?" ? "?" : sprintf("%.4f", used[i])), cpu[i] + 0, command[i]
  }
'

sample_once() {
  local reading before_at after_at
  sample_power
  note_declared
  [ -n "$run_dir" ] || return 0
  process_table >"$run_dir/before"
  before_at="$(wall_now)"
  reading="$(reading_now)"
  process_table >"$run_dir/after"
  after_at="$(wall_now)"
  [ -n "$reading" ] || return 0
  # One source for the whole run: a reading of the other kind is skipped,
  # never averaged in.
  [ -n "$run_source" ] || run_source="${reading%% *}"
  [ "${reading%% *}" = "$run_source" ] || return 0
  awk -v value="${reading#* }" -v started="$before_at" -v ended="$after_at" \
    "$record_sample_awk" "$run_dir/before" "$run_dir/after" >>"$run_dir/samples" &&
    run_count=$((run_count + 1))
}

# Judges the samples file against the bench's tree: its pid and every pid it
# declared, with their descendants in each reading's own table. Each reading
# less what that tree used over it, per core; a reading where the tree used
# CPU time that cannot be read, or where no core count or no wall time is
# known, is kept whole. Prints two lines: the verdict, as the end-of-run line
# gives it, and the culprits, read from the tables of the readings above the
# threshold (the bench's tree and the sampler left out), or nothing when no
# such reading had a table.
judge_samples_awk='
  function tree(roots, set,   n, i, grown, root) {
    n = split(roots, root, " ")
    for (i = 1; i <= n; i++) set[root[i]] = 1
    do {
      grown = 0
      for (i = 1; i <= procs; i++) if (!(p_pid[i] in set) && (p_parent[i] in set)) { set[p_pid[i]] = 1; grown = 1 }
    } while (grown)
  }
  function judge(   own, aside, i, sum, unknown, value, key) {
    if (!samples) return
    tree(roots, own)
    tree(roots " " left_out, aside)
    for (i = 1; i <= procs; i++) {
      if (!(p_pid[i] in own)) continue
      if (p_used[i] == "?") unknown = 1
      else sum += p_used[i]
    }
    value = reading + 0
    if (!unknown && cores > 0 && wall > 0) {
      value -= sum / wall / cores
      if (value < 0) value = 0
    }
    values[samples] = value
    total += value
    if (samples == 1 || value > max) max = value
    if (value <= above + 0 || !tabled) return
    # A noisy reading with a table: its processes add to the culprits.
    noisy_tables++
    for (i = 1; i <= procs; i++) {
      if (p_pid[i] in aside || p_cpu[i] + 0 <= 0) continue
      key = p_pid[i] " " p_name[i]
      if (!(key in busy)) { keys++; key_at[keys] = key; key_pid[keys] = p_pid[i]; key_name[keys] = p_name[i] }
      busy[key] += p_cpu[i]
    }
  }
  # The nearest-rank percentile: the reading at rank ceil(share * n) once
  # sorted, so with fewer than ten readings the 90th is the busiest.
  function percentile(share,   i, j, v, rank, sorted) {
    for (i = 1; i <= samples; i++) {
      v = values[i]
      for (j = i - 1; j >= 1 && sorted[j] > v; j--) sorted[j + 1] = sorted[j]
      sorted[j + 1] = v
    }
    rank = int(share * samples)
    if (rank < share * samples) rank++
    if (rank < 1) rank = 1
    return sorted[rank]
  }
  $1 == "S" { judge(); samples++; reading = $2; wall = $3; tabled = $4; procs = 0; next }
  $1 == "P" {
    procs++
    p_pid[procs] = $2; p_parent[procs] = $3; p_used[procs] = $4; p_cpu[procs] = $5
    name = $0
    sub(/^P +[^ ]+ +[^ ]+ +[^ ]+ +[^ ]+ +/, "", name)
    p_name[procs] = name
  }
  END {
    judge()
    if (!samples) exit
    p90 = percentile(0.9)
    printf "%s besides the bench p90 %.2f, max %.2f, mean %.2f per core: %s (noisy above %.2f)\n", source, p90, max, total / samples, (p90 > above + 0 ? "noisy" : "calm"), above
    # The culprits: the processes busiest over the noisy readings, by their
    # CPU percent averaged over those readings.
    if (!noisy_tables) exit
    for (k = 1; k <= count; k++) {
      best = 0
      for (i = 1; i <= keys; i++)
        if (!(i in named) && (!best || busy[key_at[i]] > busy[key_at[best]])) best = i
      if (!best) break
      named[best] = 1
      line = line sprintf("%s%s (pid %s, %.0f%% cpu)", (k > 1 ? ", " : ""), key_name[best], key_pid[best], busy[key_at[best]] / noisy_tables)
    }
    print (k == 1 ? "none" : line)
  }
'

# The worse of what the run kept and a new reading: the new one when it
# compares as $3 says to the kept one. An unknown new reading leaves what an
# earlier one found.
worse() { # $1 = kept so far, $2 = new reading, $3 = -gt (higher is worse) | -lt
  if is_number "$2" && { ! is_number "$1" || [ "$2" "$3" "$1" ]; }; then
    printf '%s' "$2"
  else
    printf '%s' "$1"
  fi
}

# Keeps the worst thermal readings of the run and whether it ever ran on
# battery.
sample_power() {
  local power
  if [ -n "$run_pmset" ]; then
    run_speed_limit="$(worse "$run_speed_limit" "$(speed_limit "$run_pmset")" -lt)"
    power="$(power_source "$run_pmset")"
    case "$power:$run_power" in
      battery:* | mains:unknown | mains:) run_power="$power" ;;
    esac
  fi
  if [ -n "$run_notifyutil" ]; then
    run_pressure="$(worse "$run_pressure" "$(thermal_pressure "$run_notifyutil")" -gt)"
  fi
}

# What the thermal and power readings add to the end-of-run line, if anything.
power_verdict() {
  if [ -n "$run_pmset" ]; then
    case "$run_speed_limit" in
      *[!0-9]* | "") printf '; CPU speed limit unknown' ;;
      *) [ "$run_speed_limit" -ge 100 ] || printf '; CPU speed limit down to %s%%: noisy' "$run_speed_limit" ;;
    esac
  fi
  if [ -n "$run_notifyutil" ]; then
    case "$run_pressure" in
      0) ;;
      1) printf '; thermal pressure moderate: noisy' ;;
      2) printf '; thermal pressure heavy: noisy' ;;
      3) printf '; thermal pressure trapping: noisy' ;;
      4) printf '; thermal pressure sleeping: noisy' ;;
      *[!0-9]* | "") printf '; thermal pressure unknown' ;;
      *) printf '; thermal pressure level %s: noisy' "$run_pressure" ;;
    esac
  fi
  if [ -n "$run_pmset" ]; then
    case "$run_power" in
      battery) printf '; on battery power: noisy' ;;
      mains) ;;
      *) printf '; power source unknown' ;;
    esac
  fi
}

say_run_verdict() {
  local verdict="" culprits="" cores
  # A last look at what the bench declared, while the lock is still its own:
  # the next bench empties the file and lists its own pids there.
  if read_record "$lock" && [ "$record_pid" = "$run_bench" ]; then note_declared; fi
  if [ "$run_count" -gt 0 ]; then
    cores="$(getconf _NPROCESSORS_ONLN 2>/dev/null)"
    is_number "$cores" || cores=0
    {
      IFS= read -r verdict
      IFS= read -r culprits
    } < <(awk -v source="$run_source" -v above="$(noisy_above)" -v cores="$cores" \
      -v roots="$run_bench$run_declared" -v left_out="$run_left_out" -v count="$culprit_count" \
      "$judge_samples_awk" "$run_dir/samples" 2>/dev/null)
  fi
  [ -n "$verdict" ] || verdict="load unknown: no verdict"
  verdict="$verdict$(power_verdict)"
  echo "bench-lock: on $(machine_name), during the run, $verdict" >&2
  case "$verdict" in *": noisy"*) say_culprits "$culprits" ;; esac
}

# The window the line covers starts when the bench does, and starts over when
# the holder itself (the bench's own process) calls `bench-lock settle`: a
# command that prepares before it measures (bench-remote's job, through its
# fetch and install) settles once ready, so that the verdict covers what it
# measures alone. The settle leaves a token in the lock directory, the
# holder's pid first; the sampler reads it at every poll, and on a new one
# drops every reading kept so far and reads the machine at once.
window_token() { # $1 = the holder's pid
  local token=""
  { IFS= read -r token <"$lock/window"; } 2>/dev/null
  case "$token" in "$1 "*) printf '%s' "$token" ;; esac
}

# Called by `settle` on its way out: a no-op unless its parent holds the lock.
mark_window() {
  case "${XDG_STATE_HOME:-}" in /*) ;; *) [ -n "${HOME:-}" ] || return 0 ;; esac
  resolve_state
  read_record "$lock" && [ "$record_pid" = "$PPID" ] || return 0
  {
    printf '%s %s %s\n' "$PPID" "$$" "$(date +%s)" >"$lock/window.$$" &&
      mv -f "$lock/window.$$" "$lock/window"
  } 2>/dev/null
}

run_window=""
window_moved() { # $1 = the holder's pid
  local token
  token="$(window_token "$1")"
  [ -n "$token" ] && [ "$token" != "$run_window" ] || return 1
  run_window="$token"
  reset_run_readings
}

# Once the line is out, the file BENCH_LOCK_END_MARKER names is created, for a
# caller that cannot wait on a pipe: one whose stderr is a file, where a child
# the bench left behind would hold a pipe open long after the bench is gone.
run_end_marker=""
sample_run() { # $1 = the bench's pid, $2 = its start time
  local next_sample
  trap '' HUP INT QUIT TERM
  # The bench is no culprit, and neither is this sampler: bash 3.2 has no
  # BASHPID, but a child that replaces itself with sh has this process as its
  # parent.
  run_left_out="$1 $(exec sh -c 'echo "$PPID"')"
  run_bench="$1"
  run_pmset="$(macos_program "${BENCH_LOCK_PMSET:-}" /usr/bin/pmset)"
  run_notifyutil="$(macos_program "${BENCH_LOCK_NOTIFYUTIL:-}" /usr/bin/notifyutil)"
  run_window="$(window_token "$1")"
  # The readings are kept in a file of their own, not in the lock directory:
  # the next bench may take that over as soon as this one is gone.
  run_dir="$(mktemp -d "${TMPDIR:-/tmp}/bench-lock.XXXXXX" 2>/dev/null)" || run_dir=""
  reset_run_readings
  # A first reading at once: a bench shorter than a period is sampled too.
  sample_once
  next_sample=$((SECONDS + sample_every))
  # SECONDS counts whole seconds, so the period is only due after a sleep: the
  # pass right behind the first reading takes none on the clock. Otherwise a
  # second that ticks over during that reading makes the next one due at once,
  # two readings a few milliseconds apart, and the first one counts twice.
  local first_pass=1
  while kill -0 "$1" 2>/dev/null; do
    if window_moved "$1"; then
      sample_once
      next_sample=$((SECONDS + sample_every))
    elif [ -z "$first_pass" ] && [ "$SECONDS" -ge "$next_sample" ]; then
      is_dead "$1" "$2" && break
      sample_once
      next_sample=$((SECONDS + sample_every))
    fi
    first_pass=""
    sleep "$poll_every"
  done
  # A settle the bench called just before it ended.
  if window_moved "$1"; then sample_once; fi
  say_run_verdict
  if [ -n "$run_dir" ]; then rm -rf "$run_dir"; fi
  if [ -n "$run_end_marker" ]; then { : >"$run_end_marker"; } 2>/dev/null; fi
}

start_sampler() { # $1 = the bench's pid, $2 = its start time
  run_end_marker="${BENCH_LOCK_END_MARKER:-}"
  (sample_run "$1" "$2" </dev/null >/dev/null &)
}

# ── run ──────────────────────────────────────────────────────────────────────
# A waiter looks every $poll_every seconds: a bench that ends is noticed about
# that late. BENCH_LOCK_POLL_SECONDS tunes it, for this tool's own tests.
poll_every=1

# The line a waiter prints, at once and then every $notice_every seconds: a long
# wait must not look like a hang. BENCH_LOCK_NOTICE_SECONDS tunes the period.
notice_every=60
next_notice=0
say_waiting() {
  local message="waiting for the bench lock"
  [ "$SECONDS" -ge "$next_notice" ] || return 0
  next_notice=$((SECONDS + notice_every))
  if read_record "$lock" && ! is_dead "$record_pid" "$record_started"; then
    set_age "$record_since" "$(date +%s)"
    message="$message, held for $age by pid $record_pid ($record_command, in $record_cwd)"
  fi
  [ "$queue_ahead" -eq 0 ] || message="$message; $queue_ahead ahead in the queue"
  echo "bench-lock: $message" >&2
}

# The periods tuned by the environment, read by `run` and `settle` alike.
read_periods() {
  if is_number "${BENCH_LOCK_NOTICE_SECONDS:-}"; then
    notice_every="$BENCH_LOCK_NOTICE_SECONDS"
  fi
  # A number, decimals allowed, and not zero: a poll that never sleeps would
  # steal the machine from the bench it waits for.
  case "${BENCH_LOCK_POLL_SECONDS:-}" in
    *[!0-9.]* | *.*.*) ;;
    *[1-9]*) poll_every="$BENCH_LOCK_POLL_SECONDS" ;;
  esac
  if is_number "${BENCH_LOCK_SAMPLE_SECONDS:-}" && [ "$BENCH_LOCK_SAMPLE_SECONDS" -gt 0 ]; then
    sample_every="$BENCH_LOCK_SAMPLE_SECONDS"
  fi
}

# A waiter leaves the queue on every way out but `exec`: its ticket is its own
# to remove, and nobody else's. A signal that lands between taking the lock and
# the `exec` gives the lock back too: no command ran under it.
holding=""
leave() {
  if [ -n "$ticket" ] && read_record "$ticket" && [ "$record_pid" = "$$" ]; then
    remove "$ticket"
  fi
  if [ -n "$holding" ] && read_record "$lock" && [ "$record_pid" = "$$" ]; then
    remove "$lock"
  fi
  ticket="" holding=""
}

# A signal makes a waiter leave the queue with the usual 128+n. The handler
# only takes note; the note is read at the next safe point, never between a
# `mkdir` and the record that names its owner.
leaving_with=""
leave_if_asked() {
  [ -z "$leaving_with" ] || exit "$leaving_with"
}

# What `exec` would refuse, refused before queueing, with the conventional
# code and one clear line: a typo must not wait for its turn, and the old bash
# macOS ships says 126 for a missing file, and says it twice.
check_runnable() { # $1 = the command
  case "$1" in
    */*)
      if [ ! -e "$1" ]; then
        echo "bench-lock: $1: No such file or directory" >&2
        exit 127
      elif [ -d "$1" ]; then
        echo "bench-lock: $1: Is a directory" >&2
        exit 126
      elif [ ! -x "$1" ]; then
        echo "bench-lock: $1: Permission denied" >&2
        exit 126
      fi
      ;;
    *)
      if ! type -P "$1" >/dev/null; then
        echo "bench-lock: $1: command not found" >&2
        exit 127
      fi
      ;;
  esac
}

run() {
  local now
  # Re-entrance: under a lock that is already held, this process simply becomes
  # the command. A wrapped script that calls another wrapped script must not
  # wait for itself.
  check_runnable "$1"
  if [ -n "${BENCH_LOCK_HELD:-}" ]; then exec "$@"; fi
  command_line="$*"
  read_periods
  resolve_state
  mkdir -p "$tickets" || die "cannot create the state directory $tickets"
  look_up "$$"
  own_started="$process_started"
  trap leave EXIT
  trap 'leaving_with=129' HUP
  trap 'leaving_with=130' INT
  trap 'leaving_with=131' QUIT
  trap 'leaving_with=143' TERM

  # Wait in place: take a ticket, then poll until it is the first one and the
  # lock is free. No time limit: a queued bench is never turned into a failure.
  take_ticket
  while :; do
    leave_if_asked
    if [ ! -d "$ticket" ]; then
      echo "bench-lock: lost its place in the queue, joining again at the back" >&2
      take_ticket
    fi
    if is_first_in_line; then
      now="$(date +%s)"
      # The lock first, the ticket second: at no point is the queue's head
      # gone while the lock still looks free to the next in line.
      if take_lock "$now"; then
        holding=1
        break
      fi
    fi
    say_waiting
    sleep "$poll_every"
  done

  remove "$ticket"
  ticket=""
  # Said by the process that holds the lock, so once per bench: a nested run
  # passed straight through above, and a waiter has nothing to judge yet.
  settle
  # From here a signal does what it would do to the command: this process is
  # about to be the command, and the lock is free once it is gone, however it
  # goes. A signal already noted is acted on now.
  trap - HUP INT QUIT TERM
  leave_if_asked
  trap - EXIT
  run_own_pids="$lock/own-pids"
  { : >"$run_own_pids"; } 2>/dev/null
  start_sampler "$$" "$own_started"
  # The marker is the sampler's to create, never a nested run's.
  unset BENCH_LOCK_END_MARKER
  export BENCH_LOCK_HELD=1 BENCH_LOCK_OWN_PIDS="$run_own_pids"
  exec "$@"
}

case "${1:-}" in
  run)
    [ "${2:-}" = "--" ] && [ "$#" -ge 3 ] || usage
    shift 2
    run "$@"
    ;;
  status)
    [ "$#" -eq 1 ] || usage
    status
    ;;
  reading)
    [ "$#" -eq 1 ] || usage
    read_machine
    echo "$reading"
    ;;
  settle)
    # No lock is taken or given back here, so a signal needs no handler: it
    # ends the wait as it would any process. BENCH_LOCK_HELD changes nothing.
    [ "$#" -eq 1 ] || usage
    read_periods
    settle
    mark_window
    ;;
  *) usage ;;
esac
