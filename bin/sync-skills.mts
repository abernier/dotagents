#!/usr/bin/env -S node --import tsx
import {
  existsSync,
  lstatSync,
  mkdirSync,
  readdirSync,
  readFileSync,
  readlinkSync,
  realpathSync,
  rmSync,
  symlinkSync,
  writeFileSync,
  unlinkSync,
} from "node:fs";
import { basename, dirname, join, relative, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { parseArgs } from "node:util";
import { parse } from "yaml";
import { z } from "zod";

const banner =
  "<!-- Generated by bin/sync-skills.mts. Edit the shared source, then regenerate. -->";
const metadataSchema = z.object({
  name: z
    .string()
    .regex(/^[a-z0-9-]+$/)
    .optional()
    .describe("Explicit skill invocation name."),
  description: z
    .string()
    .min(1)
    .describe("When the workflow should be selected."),
  "disable-model-invocation": z
    .boolean()
    .optional()
    .describe("Restrict the workflow to explicit user invocation."),
  "codex-adapter": z
    .boolean()
    .optional()
    .describe(
      "Generate a Codex runtime adapter instead of linking the portable skill.",
    ),
});

function exists(path: string) {
  try {
    lstatSync(path);
    return true;
  } catch (error) {
    if (error instanceof Error && "code" in error && error.code === "ENOENT")
      return false;
    throw error;
  }
}

function linksTo(path: string, target: string) {
  return (
    exists(path) &&
    lstatSync(path).isSymbolicLink() &&
    resolve(dirname(path), readlinkSync(path)) === target
  );
}

/** Only directories produced by this generator (including its previous version) are managed. */
function managedDirectory(path: string, name: string) {
  if (
    !exists(path) ||
    !lstatSync(path).isDirectory() ||
    lstatSync(path).isSymbolicLink()
  )
    return false;
  if (readdirSync(path).sort().join(",") !== "SKILL.md,agents") return false;
  const skill = join(path, "SKILL.md");
  const agents = join(path, "agents");
  const policy = join(agents, "openai.yaml");
  if (
    !lstatSync(skill).isFile() ||
    lstatSync(skill).isSymbolicLink() ||
    !lstatSync(agents).isDirectory() ||
    lstatSync(agents).isSymbolicLink() ||
    readdirSync(agents).join(",") !== "openai.yaml" ||
    !lstatSync(policy).isFile() ||
    lstatSync(policy).isSymbolicLink()
  )
    return false;
  const text = readFileSync(skill, "utf8");
  if (text.includes(banner)) return true;
  const old =
    /^---\nname: ([a-z0-9-]+)\ndescription: ("[^\n]*")\n---\n\n(?:Invoke only when the user explicitly requests this workflow\.\n\n)?Read `~\/\.codex\/bridge\/runtime\.md` for Codex runtime mappings\.\nThen read `~\/\.claude\/(?:skills\/[a-z0-9-]+\/SKILL|commands\/[a-z0-9-]+)\.md` and follow its workflow with those mappings\.\nThe original file is the source of truth; resolve its references from its own directory\.\n$/;
  return (
    old.exec(text)?.[1] === name &&
    /^policy:\n  allow_implicit_invocation: (?:true|false)\n$/.test(
      readFileSync(policy, "utf8"),
    )
  );
}

/**
 * Refresh discovery links and the adapters required by runtime-specific workflows.
 * @param repo Repository checkout containing shared sources and tool discovery directories.
 */
export function syncSkills(
  repo: string,
  { check = false }: { check?: boolean } = {},
) {
  repo = resolve(repo);
  const entries: {
    name: string;
    claudeLink: string;
    claudeTarget: string;
    adapter: boolean;
    target: string;
    content: string;
    policy: string;
  }[] = [];
  for (const category of ["skills", "commands"] as const) {
    const directory = join(repo, "shared", category);
    for (const file of readdirSync(directory, { withFileTypes: true }).sort(
      (a, b) => a.name.localeCompare(b.name),
    )) {
      const source =
        category === "skills" && file.isDirectory()
          ? join(directory, file.name, "SKILL.md")
          : category === "commands" &&
              file.isFile() &&
              file.name.endsWith(".md")
            ? join(directory, file.name)
            : undefined;
      if (!source || !existsSync(source)) continue;
      const front = readFileSync(source, "utf8").match(
        /^---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/,
      );
      if (!front) throw new Error(`Missing frontmatter: ${source}`);
      const fields = metadataSchema.parse(parse(front[1]));
      const name =
        fields.name ??
        (category === "skills"
          ? basename(dirname(source))
          : basename(source, ".md"));
      if (!/^[a-z0-9-]+$/.test(name))
        throw new Error(`Invalid skill name: ${source}`);
      const adapter =
        category === "commands" || fields["codex-adapter"] === true;
      const explicit =
        category === "commands" || fields["disable-model-invocation"] === true;
      const target = adapter
        ? join(repo, ".codex/bridge/skills", name)
        : dirname(source);
      const original = `~/.agents/${relative(repo, source).split("\\").join("/")}`;
      const content = `---\nname: ${name}\ndescription: ${JSON.stringify(fields.description)}\n${explicit ? "disable-model-invocation: true\n" : ""}---\n\n${banner}\n\n${explicit ? "Invoke only when the user explicitly requests this workflow.\n\n" : ""}Read \`~/.codex/bridge/runtime.md\` for Codex runtime mappings.\nThen read \`${original}\` and follow its workflow with those mappings.\nThe original file is the source of truth; resolve its references from its own directory.\n`;
      entries.push({
        name,
        claudeLink: join(repo, ".claude", category, file.name),
        claudeTarget: category === "skills" ? dirname(source) : source,
        adapter,
        target,
        content,
        policy: `policy:\n  allow_implicit_invocation: ${!explicit}\n`,
      });
    }
  }
  if (new Set(entries.map((entry) => entry.name)).size !== entries.length)
    throw new Error("Duplicate skill names");
  const generated = join(repo, ".codex/bridge/skills");
  const existing = exists(generated) ? readdirSync(generated) : [];
  for (const name of existing) {
    if (!managedDirectory(join(generated, name), name))
      throw new Error(
        `Refusing to replace unrelated adapter: ${join(generated, name)}`,
      );
  }
  const links = entries.flatMap((entry) => [
    {
      path: join(repo, ".agents/skills", entry.name),
      target: entry.target,
      previous: existing.includes(entry.name)
        ? join(generated, entry.name)
        : undefined,
    },
    { path: entry.claudeLink, target: entry.claudeTarget, previous: undefined },
  ]);
  for (const link of links) {
    if (
      exists(link.path) &&
      !linksTo(link.path, link.target) &&
      !(link.previous && linksTo(link.path, link.previous))
    ) {
      throw new Error(`Refusing to replace unrelated skill: ${link.path}`);
    }
  }
  const staleLinks: string[] = [];
  const managedRoots = [
    join(repo, "shared/skills"),
    join(repo, "shared/commands"),
    generated,
  ];
  for (const directory of [
    ".agents/skills",
    ".claude/skills",
    ".claude/commands",
  ]) {
    const root = join(repo, directory);
    if (!exists(root)) continue;
    for (const file of readdirSync(root, { withFileTypes: true })) {
      const path = join(root, file.name);
      if (!file.isSymbolicLink() || links.some((link) => link.path === path))
        continue;
      const target = resolve(root, readlinkSync(path));
      if (managedRoots.some((managed) => target.startsWith(managed + "/")))
        staleLinks.push(path);
    }
  }
  const stale = existing.filter(
    (name) => !entries.some((entry) => entry.adapter && entry.name === name),
  );
  const drift: string[] = stale.map((name) => `Stale adapter: ${name}`);
  for (const path of staleLinks)
    drift.push(`Stale discovery link: ${relative(repo, path)}`);
  for (const link of links) {
    if (!linksTo(link.path, link.target))
      drift.push(`Discovery link: ${relative(repo, link.path)}`);
  }
  for (const entry of entries) {
    if (entry.adapter) {
      for (const [file, expected] of [
        ["SKILL.md", entry.content],
        ["agents/openai.yaml", entry.policy],
      ]) {
        const path = join(entry.target, file!);
        if (!existsSync(path) || readFileSync(path, "utf8") !== expected)
          drift.push(`Generated file: ${entry.name}/${file}`);
      }
    }
  }
  if (check) {
    if (drift.length)
      throw new Error(`Skill synchronization drift:\n${drift.join("\n")}`);
    return entries.length;
  }
  for (const path of staleLinks) unlinkSync(path);
  for (const name of stale) {
    const link = join(repo, ".agents/skills", name);
    if (linksTo(link, join(generated, name))) unlinkSync(link);
    rmSync(join(generated, name), { recursive: true });
  }
  for (const entry of entries) {
    if (entry.adapter) {
      mkdirSync(join(entry.target, "agents"), { recursive: true });
      writeFileSync(join(entry.target, "SKILL.md"), entry.content);
      writeFileSync(join(entry.target, "agents/openai.yaml"), entry.policy);
    }
  }
  for (const link of links) {
    mkdirSync(dirname(link.path), { recursive: true });
    if (!linksTo(link.path, link.target)) {
      if (exists(link.path)) unlinkSync(link.path);
      symlinkSync(relative(dirname(link.path), link.target), link.path);
    }
  }
  return entries.length;
}

if (
  process.argv[1] &&
  realpathSync(process.argv[1]) === realpathSync(fileURLToPath(import.meta.url))
) {
  const { values } = parseArgs({
    options: {
      repo: { type: "string" },
      check: { type: "boolean", default: false },
    },
  });
  const repo = resolve(
    values.repo ?? join(dirname(fileURLToPath(import.meta.url)), ".."),
  );
  const count = syncSkills(repo, { check: values.check });
  console.log(
    `${count} skill discovery entries ${values.check ? "verified" : "synchronized"}.`,
  );
}
